# ============================================================
# Copia este archivo como ".env" y llena los valores.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore)
# ============================================================

# --- Flask ---
# Genera ambas claves con:  python scripts/generar_claves.py
SECRET_KEY=cambia-esto
FERNET_KEY=cambia-esto
FLASK_DEBUG=1

# --- Contraseña del usuario "sa" de los contenedores Docker ---
# Debe tener mayúsculas, minúsculas, números y símbolos (mínimo 8)
SA_PASSWORD=Atalaya_2026!

# --- Base de datos propia del sistema (AtalayaMeta) ---
META_SERVER=localhost
META_PORT=1433
META_DB=AtalayaMeta
META_USER=sa
META_PASSWORD=Atalaya_2026!

# --- Driver ODBC instalado en tu computadora ---
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Usuario administrador inicial de la plataforma ---
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@atalaya.local
ADMIN_PASSWORD=Admin123!

# --- Recolector automático de métricas (segundos) ---
RECOLECTOR_INTERVALO=60
